# AlphaGPT Environment Variables Template
# Usage: cp .env.example .env  then fill in real values
# Do NOT commit .env (it is gitignored). Only .env.example is tracked.
# See data_pipeline/config.py, execution/config.py, strategy_manager/runner.py, dashboard/data_service.py

# === Database ===
# Optional | format: postgres username | example: postgres
DB_USER=postgres
# Optional | format: password string | example: password
DB_PASSWORD=password
# Optional | format: hostname | example: localhost
DB_HOST=localhost
# Optional | format: port number | example: 5432
DB_PORT=5432
# Optional | format: database name | example: crypto_quant
DB_NAME=crypto_quant

# === Birdeye ===
# Required | format: api key string from birdeye.so | example: your_birdeye_api_key_here
BIRDEYE_API_KEY=your_birdeye_api_key_here
# Optional | format: https URL | example: https://public-api.birdeye.so
BIRDEYE_BASE_URL=https://public-api.birdeye.so

# === Solana / Execution ===
# Required | format: https URL (QuickNode or any Solana RPC) | example: https://api.mainnet-beta.solana.com
QUICKNODE_RPC_URL=https://api.mainnet-beta.solana.com
# Required | format: base58 string, 32-byte seed (do NOT commit real key) | example: 11111111111111111111111111111111
SOLANA_PRIVATE_KEY=11111111111111111111111111111111

# === Dashboard ===
# Optional | format: token string | example: your_dashboard_token_here (if set, EMERGENCY STOP requires matching token)
DASHBOARD_TOKEN=

# === Runtime ===
# Optional | format: file path for stop signal | example: STOP_SIGNAL
STOP_SIGNAL_PATH=STOP_SIGNAL
